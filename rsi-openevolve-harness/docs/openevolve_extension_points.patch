 logger = logging.getLogger(__name__)
 
+# ---------------------------------------------------------------------------
+# Harness extension points (added by rsi-openevolve-harness, see
+# docs/OPENEVOLVE_PATCH.md). Both are optional and configured through
+# environment variables holding "package.module:function":
+#   OPENEVOLVE_PROMPT_EXTRAS   worker side, returns extra prompt template variables
+#   OPENEVOLVE_ITERATION_HOOK  main process, called once per finished iteration
+# A failing extension never aborts the evolution run.
+# ---------------------------------------------------------------------------
+_EXTENSION_CACHE: Dict[str, Any] = {}
+
+
+def _load_extension(env_name: str):
+    """Resolve the callable named by environment variable `env_name` (cached per process)"""
+    spec = os.environ.get(env_name)
+    if not spec:
+        return None
+    cached = _EXTENSION_CACHE.get(env_name)
+    if cached is not None and cached[0] == spec:
+        return cached[1]
+    module_name, _, attr = spec.partition(":")
+    func = getattr(importlib.import_module(module_name), attr)
+    _EXTENSION_CACHE[env_name] = (spec, func)
+    return func
+
+
+def _prompt_extras(context: Dict[str, Any]) -> Dict[str, str]:
+    """Extra keyword arguments for PromptSampler.build_prompt (empty when no provider is set)"""
+    try:
+        provider = _load_extension("OPENEVOLVE_PROMPT_EXTRAS")
+        if provider is None:
+            return {}
+        return {str(key): str(value) for key, value in (provider(context) or {}).items()}
+    except Exception:
+        logger.exception("Prompt extras provider failed; continuing without extras")
+        return {}
+
+
+def _notify_iteration(event: Dict[str, Any]) -> None:
+    """Report one finished iteration to the optional iteration hook"""
+    try:
+        hook = _load_extension("OPENEVOLVE_ITERATION_HOOK")
+        if hook is not None:
+            hook(event)
+    except Exception:
+        logger.exception("Iteration hook failed; continuing")
+
+
 _worker_event_loop = None
 
 
